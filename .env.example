# Copie para ".env" e ajuste.  (cp .env.example .env)

# --- Identidade / fuso -------------------------------------------------------
# Descubra com: id -u  /  id -g   (Linux/macOS). No Docker Desktop/Windows, 1000/1000 funciona.
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# --- Pastas no HOST (caminhos absolutos; crie antes de subir) ---------------
# Mantenha DOWNLOADS e MUSIC no mesmo disco para moves instantâneos.
# Windows (Docker Desktop): use barras normais, ex. D:/DJ/Downloads
DOWNLOADS_DIR=./downloads
INCOMPLETE_DIR=./incomplete
MUSIC_DIR=./music

# --- Soulseek (conta da rede Soulseek) ---------------------------------------
SLSK_USERNAME=seu_usuario_soulseek
SLSK_PASSWORD=sua_senha_soulseek

# --- Web UI do slskd ---------------------------------------------------------
SLSKD_WEB_USER=admin
SLSKD_WEB_PASSWORD=troque-esta-senha

# --- Soulbeet ----------------------------------------------------------------
# Gere com: openssl rand -hex 32
SOULBEET_SECRET_KEY=troque-por-uma-string-aleatoria-longa

# --- API key do slskd (a MESMA de slskd/slskd.yml) --------------------------
# Usada pelo baixar-lista.bat. Gere com: openssl rand -hex 32
SLSKD_API_KEY_SOULBEET=troque-pela-mesma-chave-do-slskd.yml

# --- Acesso as interfaces web (opcional) -------------------------------------
# Por padrao, Soulbeet, slskd e Navidrome so abrem NESTE PC (127.0.0.1).
# Para usar de outro aparelho da rede (ex.: app Subsonic no celular com o Navidrome),
# descomente a linha abaixo. A porta 2234 do Soulseek nao muda.
# BIND_ADDR=0.0.0.0

# --- Conferencia no catalogo do MusicBrainz (opcional) ------------------------
# Contato (e-mail ou URL) enviado no User-Agent, como o MusicBrainz recomenda.
# MUSICBRAINZ_CONTATO=seu@email
