# ===================== Segredos (NUNCA publicar) =====================
.env
.env.*
!.env.example
slskd/slskd.yml
# o modelo publicado e slskd/slskd.example.yml
# certificado de assinatura do instalador (CSC_LINK, docs/distribuicao.md): vai como secret do repositorio, nunca como arquivo
*.pfx
*.p12

# ===================== Biblioteca e downloads =========================
# Ficam fora do repositório (na instalação, MUSIC_DIR / DOWNLOADS_DIR / INCOMPLETE_DIR).
# Com a barra no começo valem só na raiz: uma pasta de código chamada music/ ou downloads/ não some em silêncio.
/music/
/downloads/
/incomplete/
lista.txt
*.csv

# ===================== Dados dos servicos =============================
/navidrome/
slskd/*
!slskd/slskd.example.yml
soulbeet/data/

# ===================== Relatorios e logs ==============================
/lotes/
*.log
diagnostico*.txt
# fixtures reais do script (o diagnostico-exemplo.txt cai na regra acima)
!app/tests/fixtures/**
*.bak
# o que o app deixa na pasta do Soulcrate: .novo ao lado de arquivo da stack editado (stack-atualizacao-service) e .tmp
# da gravação atômica das listas (listas-service); quem roda o app apontando para o clone vê isso no git status
*.novo
*.tmp

# ===================== Sistema / editores =============================
.claude/settings.local.json
# memória de trabalho dos hooks (local); a memória curada é .claude/memoria/aprendizados.md
.claude/memoria/sessoes/
.claude/memoria/.estado/
# worktrees do Claude Code (cada uma é uma cópia inteira do repositório)
.claude/worktrees/
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

# ===================== Testes =========================================
tests/resultado-pester-*.xml

# ===================== App (Electron) =================================
app/node_modules/
app/out/
app/dist/
# instaladores de teste do ciclo instalar/atualizar/desinstalar (app/scripts/testar-instalador.ps1)
app/dist-anterior/
app/dist-teste/
app/coverage/
# arquivos da stack montados para o instalador (npm run stack:preparar)
app/resources/stack/
app/test-results/
app/playwright-report/
# estado do app na pasta do Soulcrate (manifesto dos arquivos da stack)
.soulcrate/
