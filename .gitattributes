# Scripts do Windows precisam de CRLF (cmd.exe se perde com LF em .bat)
*.bat text eol=crlf
*.ps1 text eol=crlf

# O que roda dentro do contêiner Linux fica com LF
Dockerfile text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

* text=auto

# Fixtures do protocolo do lote: bytes exatos como o script grava (sem conversao de fim de linha)
app/tests/fixtures/** -text
